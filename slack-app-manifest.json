{
  "display_information": {
    "name": "ach-channelmux",
    "description": "Talk to the coding agent in your own Coder workspace.",
    "background_color": "#1d1c1d"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "ach-channelmux",
      "always_online": true
    },
    "agent_view": {
      "agent_description": "Your coding agent, in your own workspace.",
      "suggested_prompts": []
    },
    "shortcuts": [
      {
        "name": "Send to agent",
        "type": "message",
        "callback_id": "send_to_agent",
        "description": "Start a coding-agent thread with this message"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "files:read",
        "files:write",
        "im:history",
        "im:read",
        "im:write",
        "reactions:write",
        "users:read",
        "users:read.email",
        "assistant:write",
        "commands"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.im", "agent_session_stopped", "app_home_opened"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "token_rotation_enabled": false
  }
}
