    {
      "type": "stat",
      "title": "LLM spend via Slack (range)",
      "description": "LiteLLM spend of opencode under ACP (user agent opencode/…/acp), the daemon's agent, for the selected users.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(label_replace(increase(litellm_spend_metric_total{user_agent=~\"opencode/.+/acp\", user_email=~\"$owner\"}[$__range]), \"owner\", \"$1\", \"user_email\", \"(.+)\")) or vector(0)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
