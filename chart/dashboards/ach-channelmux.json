    {
      "type": "table",
      "title": "Users (range)",
      "description": "One row per owner (the daemon's user). Replies: agent messages and streams posted. LLM spend and requests: LiteLLM, opencode under ACP only (a user with spend but no row data otherwise has not connected since the relay last restarted).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (owner) (increase(channelmux_messages_total{owner=~\"$owner\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (owner) (increase(channelmux_threads_total{owner=~\"$owner\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "sum by (owner) (increase(channelmux_actions_total{owner=~\"$owner\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "sum by (owner) (increase(channelmux_files_in_total{owner=~\"$owner\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "E",
          "expr": "sum by (owner) (increase(channelmux_api_calls_total{owner=~\"$owner\", method=~\"chat.postMessage|chat.startStream\", ok=\"true\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "F",
          "expr": "sum by (owner) (label_replace(increase(litellm_spend_metric_total{user_agent=~\"opencode/.+/acp\", user_email=~\"$owner\"}[$__range]), \"owner\", \"$1\", \"user_email\", \"(.+)\")) > 0",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "G",
          "expr": "sum by (owner) (label_replace(increase(litellm_proxy_total_requests_metric_total{user_agent=~\"opencode/.+/acp\", user_email=~\"$owner\"}[$__range]), \"owner\", \"$1\", \"user_email\", \"(.+)\")) > 0",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "I",
          "expr": "sum by (owner) (increase(channelmux_events_total{owner=~\"$owner\", event=\"offline_notice\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "J",
          "expr": "max by (owner) (channelmux_daemon_connected{owner=~\"$owner\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "owner": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
