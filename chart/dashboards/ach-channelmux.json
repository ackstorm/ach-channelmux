              "Value #B": "Threads",
              "Value #C": "Actions",
              "Value #D": "Files in",
              "Value #E": "Replies",
              "Value #F": "LLM spend (Slack)",
              "Value #G": "LLM requests (Slack)",
              "Value #I": "Offline notices",
              "Value #J": "Online"
            }
